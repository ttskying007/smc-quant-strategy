   188|# ═══════════════════════════════════════════════════
   189|# V1 — K线+出入点 (原始)
   190|# ═══════════════════════════════════════════════════
   191|def build_v1(symbol):
   192|    ohlcv = load_ohlcv(symbol)
   193|    if not ohlcv: return NAV+'<p style="padding:20px;color:#8b949e;">No data for '+symbol+'</p>'
   194|    info = V28_MAP.get(symbol)
   195|    trades = info['trades'] if info else []
   196|    stock = info['data'] if info else {}
   197|
   198|    dates = [str(b.get('date',b.get('t',''))) for b in ohlcv]
   199|    ohlcv_data = [[b['o'],b['c'],b['l'],b['h']] for b in ohlcv]
   200|    entry_pts, exit_pts = [], []
   201|    for t in trades:
   202|        entry_pts.append({'coord':[dates[t['entry_idx']],t['entry_price']],'won':t['won'],'rr':t.get('rr',0),'pnl':t.get('pnl_pct',0),'num':trades.index(t)+1})
   203|        exit_pts.append({'coord':[dates[t['exit_idx']],t['exit_price']],'won':t['won'],'pnl':t.get('pnl_pct',0)})
   204|    total_pnl = sum(t.get('pnl_pct',0) for t in trades)
   205|    dates_json = json.dumps(dates)
   206|    ohlcv_json = json.dumps(ohlcv_data)
   207|    entry_json = json.dumps([{'name':'E'+str(e['num']),'coord':e['coord'],'value':'E'+str(e['num']),'itemStyle':{'color':'#3fb950' if e['won'] else '#f85149'},'symbol':'pin','symbolSize':32,'label':{'show':True,'formatter':'E'+str(e['num']),'fontSize':9,'color':'#fff','position':'top'}} for e in entry_pts])
   208|    exit_json = json.dumps([{'coord':e['coord'],'value':str(e['pnl'])+'%','itemStyle':{'color':'#79c0ff' if e['pnl']>0 else '#d29922'},'symbol':'diamond','symbolSize':16} for e in exit_pts])
   209|    opts_json = json.dumps({'dates':dates,'ohlcv':ohlcv_data},default=str)
   210|
   211|    options = ''.join(f'<option value="{s}"{" selected" if s==symbol else ""}>{s} ({V28_MAP[s]["data"]["n_trades"]}t)</option>' for s in sorted(V28_MAP.keys()))
   212|
   213|    return f'''<!DOCTYPE html><html><head><meta charset="utf-8"><title>{symbol} V1</title>
   214|<style>*{{margin:0;padding:0;box-sizing:border-box}}body{{background:#0d1117;color:#c9d1d9;font-family:system-ui,sans-serif}}
   215|.ctrl{{background:#161b22;padding:12px 20px;display:flex;align-items:center;gap:10px;}}
   216|.ctrl select{{padding:8px 12px;background:#0d1117;color:#c9d1d9;border:1px solid #30363d;border-radius:6px;font-size:14px;}}
   217|.ctrl .btn{{padding:8px 16px;background:#238636;color:#fff;border:none;border-radius:6px;cursor:pointer;font-size:14px;}}
   218|#chart{{width:100%;height:600px}}
   219|.win{{color:#3fb950}}.loss{{color:#f85149}}
   220|</style><script src="/echarts.min.js"></script></head><body>
   221|{NAV}
   222|<div class="ctrl">
   223|<form method="get"><select name="s" onchange="this.form.submit()">{options}</select>
   224|<input type="submit" class="btn" value="View"></form>
   225|<span style="color:#8b949e;">{len(trades)} trades | WR={stock.get("win_rate","?")}% | P&L={total_pnl:+.2f}%</span>
   226|</div>
   227|<div id="chart"></div>
   228|<script>
   229|var dom=document.getElementById("chart");var chart=echarts.init(dom,"dark");
   230|var dates={dates_json};var ohlcvData={ohlcv_json};
   231|var entryPts={entry_json};var exitPts={exit_json};
   232|chart.setOption({{
   233|animation:false,backgroundColor:"#0d1117",
   234|tooltip:{{trigger:"axis",axisPointer:{{type:"cross"}}}},
   235|dataZoom:[{{type:"inside",start:0,end:100}},{{type:"slider",start:0,end:100,bottom:10,height:25,borderColor:"#30363d",backgroundColor:"#161b22"}}],
   236|grid:{{left:"5%",right:"5%",bottom:"15%",top:"5%"}},
   237|xAxis:{{type:"category",data:dates,axisLine:{{lineStyle:{{color:"#30363d"}}}},axisLabel:{{rotate:45,fontSize:10,interval:30,color:"#8b949e"}},splitLine:{{show:false}}}},
   238|yAxis:{{scale:true,splitLine:{{lineStyle:{{color:"#21262d",type:"dashed"}}}},axisLabel:{{color:"#8b949e",fontSize:11}}}},
   239|series:[{{name:"K线",type:"candlestick",data:ohlcvData,
   240|itemStyle:{{color:"#f85149",color0:"#3fb950",borderColor:"#f85149",borderColor0:"#3fb950"}},
   241|markPoint:{{data:entryPts.concat(exitPts)}} }}]
   242|}});
   243|window.addEventListener("resize",function(){{chart.resize()}});
   244|</script></body></html>'''
   245|
   246|# ═══════════════════════════════════════════════════
   247|# V2 — 13 SMC信号 K线查看器
   248|# ═══════════════════════════════════════════════════
   249|def build_v2(symbol):
   250|    ohlcv = load_ohlcv(symbol)
   251|    if not ohlcv: return NAV+'<p style="padding:20px;color:#8b949e;">No data for '+symbol+'</p>'
   252|    info = V28_MAP.get(symbol)
   253|    trades = info['trades'] if info else []
   254|    stock = info['data'] if info else {}
   255|
   256|    try:
   257|        result = detect_all_signals_v11(ohlcv)
   258|        all_sigs = result.get('all',[])
   259|    except:
   260|        all_sigs = []
   261|
   262|    dates = [str(b.get('date',b.get('t',''))) for b in ohlcv]
   263|    dates_short = [str(b.get('_date',fmt_date(b.get('date',b.get('t',''))))[:10]) for b in ohlcv]
   264|    ohlcv_data = [[b['o'],b['c'],b['l'],b['h']] for b in ohlcv]
   265|
   266|    sig_counter=0
   267|    numbered_sigs=[]
   268|    for sig in all_sigs:
   269|        sig_counter+=1
   270|        sig['seq']=sig_counter
   271|        numbered_sigs.append(sig)
   272|
   273|    max_idx=len(dates)-1
   274|    mark_areas,mark_lines,mark_points=[],[],[]
   275|
   276|    for sig in numbered_sigs:
   277|        stype=sig['type'];style=SIG_STYLE.get(stype,{});family=SIG_FAMILY.get(stype,'other')
   278|        seq=sig['seq'];label=style.get('label',stype[:4]);sname=f"{seq}{label}"
   279|        idx=sig['idx']
   280|        if idx<0 or idx>=len(dates): continue
   281|        sig_date=dates_short[idx] if idx<len(dates_short) else ''
   282|        sig_upper=sig.get('upper',0);sig_lower=sig.get('lower',0);sig_price=sig.get('price',0)
   283|        sig_strength=sig.get('strength',0);sig_conf=sig.get('confidence',0);sig_dir=sig.get('direction','neutral')
   284|        tt=f'Signal #{seq}: {stype}<br/>Date: {sig_date}<br/>Direction: {sig_dir}<br/>Strength: {sig_strength:.1f}<br/>Confidence: {sig_conf:.2f}'
   285|        if sig_upper>0 and sig_lower>0: tt+=f'<br/>Range: {sig_lower:.2f} - {sig_upper:.2f}'
   286|        if sig_price>0: tt+=f'<br/>Price: {sig_price:.2f}'
   287|
   288|        if 'fill' in style:
   289|            upper=sig.get('upper',0);lower=sig.get('lower',0)
   290|            if upper>0 and lower>0 and upper!=lower:
   291|                end_x=dates[min(idx+10,max_idx)]
