   103|# ── Helpers ──
   104|def fmt_date(d):
   105|    s = str(d).strip()
   106|    if len(s) >= 10 and s[4]=='-' and s[7]=='-': return s[:10]
   107|    if len(s)==8 and s.isdigit(): return f'{s[:4]}-{s[4:6]}-{s[6:8]}'
   108|    if len(s)>=12 and s.isdigit(): return f'{s[:4]}-{s[4:6]}-{s[6:8]}'
   109|    return s
   110|
   111|def load_ohlcv(symbol):
   112|    fname = f"{symbol.replace('.','_')}_daily_300.json"
   113|    fp = CACHE / fname
   114|    if not fp.exists(): return None
   115|    data = json.loads(fp.read_text())
   116|    for b in data:
   117|        if 'date' not in b and 't' in b: b['date'] = str(b['t'])
   118|        b['_date'] = fmt_date(b.get('date',b.get('t','')))[:10]
   119|    return data
   120|
   121|def load_60m(symbol):
   122|    fname = f"{symbol.replace('.','_')}_60min_200.json"
   123|    fp = CACHE_60M / fname
   124|    if not fp.exists(): return None
   125|    data = json.loads(fp.read_text())
   126|    for b in data:
   127|        if 'date' not in b and 't' in b: b['date'] = str(b['t'])
   128|        b['_date'] = fmt_date(b.get('date',b.get('t','')))[:10]
   129|    return data
   130|
   131|def short_label(t):
   132|    return SIG_STYLE.get(t,{}).get('label',t[:4])
   133|
   134|def compute_sl_tp(signals, entry_idx, entry_price, direction):
   135|    sl, tp = None, None
   136|    for sig in signals:
   137|        if sig['idx'] >= entry_idx or sig['idx'] < entry_idx - 20: continue
   138|        if direction == 'bull':
   139|            if sig['type'] in ('SweepDown',) and sig.get('lower',0):
   140|                c = sig.get('lower',sig.get('price',0))
   141|                if sl is None or c < sl: sl = c
   142|            if sig['type'] in ('EQL_Low',) and sig.get('lower',0):
   143|                c = sig.get('lower',sig.get('price',0))
   144|                if sl is None or c < sl: sl = c
   145|            if sig['type'] in ('FVG_Bull','IFVG_Bull','OB_Bull') and sig.get('upper',0) > entry_price:
   146|                c = sig['upper']
   147|                if tp is None or c > tp: tp = c
   148|        else:
   149|            if sig['type'] in ('SweepUp',) and sig.get('upper',0):
   150|                c = sig.get('upper',sig.get('price',0))
   151|                if sl is None or c > sl: sl = c
   152|            if sig['type'] in ('EQL_High',) and sig.get('upper',0):
   153|                c = sig.get('upper',sig.get('price',0))
   154|                if sl is None or c > sl: sl = c
   155|            if sig['type'] in ('FVG_Bear','IFVG_Bear','OB_Bear') and sig.get('lower',0) < entry_price:
   156|                c = sig['lower']
   157|                if tp is None or c < tp: tp = c
   158|    if sl is None: sl = entry_price * (0.98 if direction=='bull' else 1.02)
   159|    if tp is None: tp = entry_price * (1.05 if direction=='bull' else 0.95)
   160|    return sl, tp
