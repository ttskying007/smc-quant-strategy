   462|window.addEventListener('resize',function(){{chart.resize();}});\n</script></body></html>"""
   463|
   464|def build_v2_60min(symbol):
   465|    ohlcv_60m=load_60m(symbol)
   466|    if not ohlcv_60m: return {'areas':[],'lines':[],'points':[]}
   467|    try: result=detect_all_signals_v11(ohlcv_60m,tf='60min'); all_sigs=result.get('all',[])
   468|    except: return {'areas':[],'lines':[],'points':[]}
   469|    if not all_sigs: return {'areas':[],'lines':[],'points':[]}
   470|    daily=load_ohlcv(symbol)
   471|    if not daily: return {'areas':[],'lines':[],'points':[]}
   472|    dm={}
   473|    for i,b in enumerate(daily):
   474|        d=b.get('_date',fmt_date(b.get('date',b.get('t',''))))[:10]
   475|        dm[d]=i
   476|    dd=[str(b.get('date',b.get('t',''))) for b in daily]
   477|    mx=len(dd)-1
   478|    areas,lines,points=[],[],[]
   479|    sc=0
   480|    for sig in all_sigs:
   481|        sd=fmt_date(sig.get('date',''))[:10]
   482|        if not sd or sd not in dm:
   483|            bi=sig.get('idx',0)
   484|            if bi<len(ohlcv_60m):
   485|                sd=ohlcv_60m[bi].get('_date','')[:10]
   486|            if not sd or sd not in dm: continue
   487|        di=dm[sd]; sc+=1
   488|        stype=sig['type'];style=SIG_STYLE.get(stype,{});family=SIG_FAMILY.get(stype,'other')
   489|        label=style.get('label',stype[:4]);sname=f"60m-{sc}{label}"
   490|        if 'fill' in style:
   491|            upper=sig.get('upper',0);lower=sig.get('lower',0)
   492|            if upper>0 and lower>0 and upper!=lower:
   493|                areas.append({'family':family,'signal':stype,'seq':sc,'data':[{'xAxis':dd[di],'yAxis':lower,'itemStyle':{'color':style.get('fill','rgba(255,255,255,0.08)').replace('0.2','0.08').replace('0.15','0.06').replace('0.12','0.05'),'borderColor':style.get('stroke','rgba(255,255,255,0.3)'),'borderWidth':1 if upper-lower>0.01 else 0,'borderType':'dashed','opacity':0.5}},{'xAxis':dd[min(di+5,mx)],'yAxis':upper}]})
   494|        if 'stroke' in style and 'fill' not in style:
   495|            price=sig.get('price',0)
   496|            if price==0: price=sig.get('upper',0)
   497|            if price<=0: continue
   498|            lines.append({'signal':stype,'family':family,'seq':sc,'_pair':[{'xAxis':dd[di],'yAxis':price},{'xAxis':dd[min(di+10,mx)],'yAxis':price}],'lineStyle':{'color':style.get('stroke','#888'),'type':style.get('type','dashed'),'width':1,'opacity':0.3},'label':{'show':True,'formatter':sname,'color':style.get('stroke','#888'),'fontSize':8,'position':'start'}})
   499|        price=sig.get('price',sig.get('upper',0))
   500|        if price>0:
   501|